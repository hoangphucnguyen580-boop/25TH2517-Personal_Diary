<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/bg_secondary"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Ô tìm kiếm inline, đặt trực tiếp trong Toolbar vì Toolbar cho phép chứa view con -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="48dp"
            android:background="@drawable/bg_search_field"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@string/cd_search"
                android:src="@drawable/ic_search"
                app:tint="@color/text_secondary" />

            <EditText
                android:id="@+id/edit_search"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/hint_search"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- MaterialToolbar tự có sẵn overflow menu ⋮ khi gọi inflateMenu(R.menu.menu_diary_list) trong code,
             không cần khai báo thêm view -->

    </com.google.android.material.appbar.MaterialToolbar>

    <!-- Streak: hàng icon lửa + số ngày, phía dưới có đường chỉ khâu đứt nét -->
    <LinearLayout
        android:id="@+id/streak_row"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:contentDescription="@string/cd_streak"
            android:src="@drawable/ic_flame"
            app:tint="@color/accent_terracotta" />

        <TextView
            android:id="@+id/text_streak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="@string/streak_placeholder"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

    </LinearLayout>

    <View
        android:id="@+id/streak_dashed_line"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layerType="software"
        android:background="@drawable/bg_streak_dashed"
        app:layout_constraintTop_toBottomOf="@id/streak_row"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Banner Ngày này năm xưa: nghiêng -2 độ + chấm ghim, ẩn/hiện bằng code tuỳ có bài trùng ngày hay không -->
    <View
        android:id="@+id/banner_pin"
        android:layout_width="7dp"
        android:layout_height="7dp"
        android:background="@drawable/bg_pin_dot"
        app:layout_constraintTop_toTopOf="@id/banner_on_this_day"
        app:layout_constraintStart_toStartOf="@id/banner_on_this_day"
        android:layout_marginTop="-4dp"
        android:layout_marginStart="14dp" />

    <LinearLayout
        android:id="@+id/banner_on_this_day"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/bg_card_entry"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp"
        android:rotation="-2"
        app:layout_constraintTop_toBottomOf="@id/streak_dashed_line"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/banner_thumb"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@color/bg_secondary"
            android:contentDescription="@string/cd_banner_thumb"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/banner_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/banner_title"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/banner_excerpt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/banner_placeholder"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

        </LinearLayout>

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:contentDescription="@string/cd_open"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/nav_inactive" />

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_diary"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="80dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintTop_toBottomOf="@id/banner_on_this_day"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:listitem="@layout/item_diary_entry" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_add_entry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:contentDescription="@string/cd_add_entry"
        android:src="@drawable/ic_pencil"
        app:backgroundTint="@color/accent_terracotta"
        app:tint="@color/on_accent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>