<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main">

    <!-- Chứa HomeFragment / CalendarFragment / MemoriesFragment / StatsFragment,
         đổi bằng FragmentTransaction trong MainActivity.java khi bấm bottom nav.
         KHÔNG khai báo android:name ở đây - để trống thì mới add/replace fragment
         bằng code được, khai android:name sẽ bị crash lúc mở app -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragment_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav" />

    <View
        android:id="@+id/nav_top_border"
        android:layout_width="0dp"
        android:layout_height="2dp"
        android:background="@color/accent_terracotta"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/card_bg"
        app:elevation="0dp"
        app:itemIconTint="@color/bottom_nav_color_selector"
        app:itemTextColor="@color/bottom_nav_color_selector"
        app:itemRippleColor="@color/bg_secondary"
        app:itemActiveIndicatorStyle="@style/Widget.PersonalDiary.BottomNav.NoIndicator"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav_menu"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- MỚI: Ruy băng chỉ tab đang chọn - đặt SAU bottom_nav trong XML để được
         vẽ ĐÈ LÊN cả nav_top_border lẫn phần trên cùng của bottom_nav (thứ tự
         vẽ trong ConstraintLayout đi theo thứ tự khai báo, con khai sau đè lên
         con khai trước). android:visibility="invisible" lúc đầu để tránh bị
         "giật hình" hiện tạm ở góc trái (x=0) trong 1 khung hình trước khi
         MainActivity.java kịp tính đúng vị trí tab đang chọn rồi mới hiện ra -
         xem giải thích đầy đủ ở diChuyenRuyBangToiTab() bên Java.
         layout_marginBottom ÂM để nó nhô 1 nửa lên trên đường viền, còn nửa
         dưới (phần đuôi chữ V) chồng vào bên trong bottom_nav - đúng khớp
         mockup mày gửi. Vị trí ngang (constraintStart) chỉ là điểm neo x=0 ban
         đầu, Java sẽ dùng translationX để "đẩy" nó đi chứ không sửa constraint. -->
    <ImageView
        android:id="@+id/ribbon_indicator"
        android:layout_width="14dp"
        android:layout_height="10dp"
        android:layout_marginBottom="-5dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_ribbon_bookmark"
        android:visibility="invisible"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav" />

</androidx.constraintlayout.widget.ConstraintLayout>