<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_card_entry"
    android:padding="9dp">

    <!-- Chi tiết nhận diện thương hiệu: góc giấy gấp, khớp với icon app -->
    <ImageView
        android:id="@+id/fold_corner"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_marginTop="-9dp"
        android:layout_marginEnd="-9dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_fold_corner"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/thumb"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="@color/bg_secondary"
        android:contentDescription="@string/cd_entry_thumb"
        android:scaleType="centerCrop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Badge số lượng ảnh - chỉ hiện khi bài có > 1 ảnh, set visibility="gone" trong code nếu <=1 -->
    <TextView
        android:id="@+id/badge_photo_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="-4dp"
        android:layout_marginTop="-4dp"
        android:background="@color/badge_dark"
        android:paddingStart="4dp"
        android:paddingTop="1dp"
        android:paddingEnd="4dp"
        android:paddingBottom="1dp"
        android:text="@string/photo_count_placeholder"
        android:textColor="@color/on_accent"
        android:textSize="8sp"
        app:layout_constraintStart_toStartOf="@id/thumb"
        app:layout_constraintTop_toTopOf="@id/thumb" />

    <!-- Badge mood - icon emoji tâm trạng, đè góc dưới-phải ảnh thumbnail -->
    <ImageView
        android:id="@+id/badge_mood"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginEnd="-4dp"
        android:layout_marginBottom="-4dp"
        android:background="@drawable/bg_mood_circle"
        android:contentDescription="@string/cd_mood"
        android:padding="2dp"
        android:src="@drawable/ic_mood_smile"
        app:tint="@color/accent_terracotta"
        app:layout_constraintBottom_toBottomOf="@id/thumb"
        app:layout_constraintEnd_toEndOf="@id/thumb" />

    <TextView
        android:id="@+id/text_excerpt"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="18dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="@string/entry_excerpt_placeholder"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        app:layout_constraintStart_toEndOf="@id/thumb"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/thumb" />

    <!-- Container rỗng, DiaryAdapter sẽ addView các TextView tag (bg_pill_tag) vào đây theo số nhãn thực tế -->
    <LinearLayout
        android:id="@+id/tags_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        app:layout_constraintStart_toEndOf="@id/thumb"
        app:layout_constraintTop_toBottomOf="@id/text_excerpt" />

    <TextView
        android:id="@+id/text_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/entry_date_placeholder"
        android:textColor="@color/nav_inactive"
        android:textSize="10sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>