<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Kế thừa style pill mặc định của Material3, chỉ ghi đè màu thành trong suốt
         để khớp mockup (mockup không có pill sau icon tab đang chọn) -->
    <style name="Widget.PersonalDiary.BottomNav.NoIndicator"
        parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@android:color/transparent</item>
    </style>

    <style name="Theme.PersonalDiary.PhotoViewerDialog" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

</resources>